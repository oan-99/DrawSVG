{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "shell",
            "group": "build",
            "command": "${workspaceFolder}/runcmake_win.bat configure",
            "problemMatcher": []
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "${workspaceFolder}/runcmake_win.bat RelWithDebInfo",
            "args": [],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "${workspaceFolder}/runcmake_win.bat Debug",
            "args": [],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
